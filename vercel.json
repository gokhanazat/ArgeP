{
  "version": 2,
  "buildCommand": "echo Skipping build",
  "installCommand": "echo Skipping install",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/login",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
